{
  "info": {
    "_postman_id": "b91bd937-a60f-4351-9e01-bba735379a2b",
    "name": "restful-api.dev — Data-Driven (Portfolio QA)",
    "description": "Criacao data-driven: roda uma vez por linha do arquivo data/create-objects.json (via `newman --iteration-data`). Cada iteracao cria, verifica a persistencia e limpa o objeto. Demonstra parametrizacao e reaproveitamento da mesma logica sobre varios conjuntos de dados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. POST cria a partir do dataset  ->  200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('schema do objeto criado', () => {",
              "  pm.response.to.have.jsonSchema({ type:'object', required:['id','name','data'],",
              "    properties:{ id:{type:'string'}, name:{type:'string'}, data:{type:'object'} } });",
              "});",
              "pm.test('nome veio do dataset', () => pm.expect(body.name).to.eql(pm.iterationData.get('objName')));",
              "pm.test('color veio do dataset', () => pm.expect(body.data.color).to.eql(pm.iterationData.get('objColor')));",
              "pm.environment.set('objectId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/objects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects"
          ]
        },
        "description": "POST parametrizado: cada iteracao usa uma linha do arquivo de dados.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{objName}}\",\n  \"data\": {\n    \"color\": \"{{objColor}}\",\n    \"year\": {{objYear}}\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "2. GET verifica o dado da iteracao  ->  200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('nome persistido = dataset', () => pm.expect(body.name).to.eql(pm.iterationData.get('objName')));",
              "pm.test('color persistido = dataset', () => pm.expect(body.data.color).to.eql(pm.iterationData.get('objColor')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/objects/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "{{objectId}}"
          ]
        },
        "description": "Persistencia por iteracao: confere que gravou o que o dataset mandou."
      },
      "response": []
    },
    {
      "name": "3. DELETE limpa o dado da iteracao  ->  200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('mensagem confirma remocao', () => pm.expect(pm.response.json().message).to.include('deleted'));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/objects/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "{{objectId}}"
          ]
        },
        "description": "Cleanup: remove o objeto criado nesta iteracao para nao deixar lixo."
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('nao retornou 500', () => pm.expect(pm.response.code).to.not.equal(500));",
          "pm.test('Content-Type e JSON', () => {",
          "  const ct = pm.response.headers.get('Content-Type') || '';",
          "  pm.expect(ct).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.restful-api.dev"
    }
  ]
}