  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Checagem global aplicada apos CADA request da colecao (DRY):",
          "// nenhum endpoint pode responder 500 — erro de servidor e sempre falha, nunca esperado.",
          "pm.test('nao retornou 500 (erro de servidor)', () => {",
          "  pm.expect(pm.response.code).to.not.equal(500);",
