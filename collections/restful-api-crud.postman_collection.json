                  "pm.test('cada item respeita o contrato minimo', () => {",
                  "  pm.expect(arr[0]).to.have.property('id');",
                  "  pm.expect(arr[0]).to.have.property('name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects",
